# ─────────────────────────────────────────────────────────────
# CoFoundr AI — Phase 6 Environment Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# Generate JWT_SECRET_KEY with: openssl rand -hex 32
# ─────────────────────────────────────────────────────────────

# ── PostgreSQL ────────────────────────────────────────────────
# Async connection string used by SQLAlchemy + asyncpg at runtime
DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/cofoundr_dev

# Sync connection string used by Alembic migrations only
ALEMBIC_DATABASE_URL=postgresql+psycopg2://<user>:<password>@localhost:5432/cofoundr_dev

# Separate test database — used by pytest only, never your dev DB
TEST_DATABASE_URL=postgresql+asyncpg://<user>:<password>@localhost:5432/cofoundr_test

# Supabase
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
SUPABASE_SECRET_KEY=sb_secret_...

# ── ChromaDB ──────────────────────────────────────────────────
CHROMA_HOST=localhost
CHROMA_PORT=8000
CHROMA_PERSIST_DIRECTORY=./data/chroma_db
CHROMA_COLLECTION_NAME=cofoundr_documents
CHROMA_MEMORY_COLLECTION_NAME=cofoundr_memories

# ── File Storage ──────────────────────────────────────────────
FILE_STORAGE_PATH=./file_storage
MAX_FILE_SIZE_BYTES=52428800

# ── JWT Auth ──────────────────────────────────────────────────
# Generate with: openssl rand -hex 32
JWT_SECRET_KEY=REPLACE_WITH_GENERATED_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SUPABASE_JWT_ISSUER=https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_AUDIENC=authenticated
SUPABASE_JWT_JWKS_URL=https://<project-ref>.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_SECRET=
SUPABASE_STORAGE_BUCKET=

# ── Application ───────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]
MAX_CONCURRENT_TASKS=5

# ── Debug Flags ───────────────────────────────────────────────
GROQ_DEBUG_REQUESTS=0

# ── Gemini API Keys (up to 20, rotation pool) ─────────────────
# Used for: embeddings + LLM analysis calls
# At minimum GEMINI_API_KEY_1 must be set
GEMINI_API_KEY_1=GEMINI_KEY_PLACEHOLDER_1
GEMINI_API_KEY_2=GEMINI_KEY_PLACEHOLDER_2
GEMINI_API_KEY_3=GEMINI_KEY_PLACEHOLDER_3
GEMINI_API_KEY_4=GEMINI_KEY_PLACEHOLDER_4
GEMINI_API_KEY_5=GEMINI_KEY_PLACEHOLDER_5
GEMINI_API_KEY_6=GEMINI_KEY_PLACEHOLDER_6
GEMINI_API_KEY_7=GEMINI_KEY_PLACEHOLDER_7
GEMINI_API_KEY_8=GEMINI_KEY_PLACEHOLDER_8
GEMINI_API_KEY_9=GEMINI_KEY_PLACEHOLDER_9
GEMINI_API_KEY_10=GEMINI_KEY_PLACEHOLDER_10
GEMINI_API_KEY_11=GEMINI_KEY_PLACEHOLDER_11
GEMINI_API_KEY_12=GEMINI_KEY_PLACEHOLDER_12
GEMINI_API_KEY_13=GEMINI_KEY_PLACEHOLDER_13
GEMINI_API_KEY_14=GEMINI_KEY_PLACEHOLDER_14
GEMINI_API_KEY_15=GEMINI_KEY_PLACEHOLDER_15
GEMINI_API_KEY_16=GEMINI_KEY_PLACEHOLDER_16
